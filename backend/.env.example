# Copy to .env and edit.
PROJECT_NAME=To-Do API
DATABASE_URL=postgresql+psycopg2://todo_user:todo_pass@localhost:5432/todo_db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Optional: an admin account is created on startup if it does not exist yet.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin12345
FIRST_ADMIN_NAME=System Admin

# --- Chatbot Assistant (OpenRouter) ---------------------------------------
# Get a key at https://openrouter.ai/keys. The key stays on the server only.
OPENROUTER_API_KEY=your_openrouter_api_key
# Any model id from https://openrouter.ai/models (filter by "free"), e.g. a ":free" model.
OPENROUTER_MODEL=your_free_model_id
# auto | native | json   (auto = native tool calling, falls back to validated JSON)
OPENROUTER_TOOL_MODE=auto
